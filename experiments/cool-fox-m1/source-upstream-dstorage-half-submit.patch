+    #[test]
+    fn full_queue_makes_progress_without_a_half_submit() {
+        if half_submits() {
+            return;
+        }
+        let bytes = pattern(64);
+        let (_dir, file) = file_with(&bytes);
+        let queue = queue_with_capacity(0, 4);
+        let array = status_array(2);
+        let mut buffers = [[0u8; 16]; 3];
+        for (i, out) in buffers.iter_mut().enumerate() {
+            enqueue(queue, &request(0, out.as_mut_ptr().cast(), 16, file, (16 * i) as u64, 16));
+            if i == 0 {
+                enqueue_status(queue, array, 0);
+            }
+        }
+        assert_eq!(wait(array, 0), S_OK);
+        enqueue_status(queue, array, 1);
+        void(queue, 0x30);
+        assert_eq!(wait(array, 1), S_OK);
+        for (i, out) in buffers.iter().enumerate() {
+            assert_eq!(out, &bytes[i * 16..(i + 1) * 16]);
+        }
+        // A batch of status entries completes synchronously. The enqueue
+        // that fills it must recheck capacity without waiting for a worker.
+        let statuses = status_array(4);
+        for i in 0..4 {
+            enqueue_status(queue, statuses, i);
+        }
+        for i in 0..3 {
+            assert_eq!(result(statuses, i), S_OK);
+        }
+        assert_eq!(result(statuses, 3), E_PENDING);
+        void(queue, 0x30);
+        assert_eq!(wait(statuses, 3), S_OK);
+    }
