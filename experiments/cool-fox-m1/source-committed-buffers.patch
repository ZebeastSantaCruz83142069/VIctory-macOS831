+/// Retires aliased views if the title successfully releases or decommits memory.
+#[cfg(feature = "diagnostics")]
+pub fn free_committed_allocation(base: usize, len: usize, free: impl FnOnce() -> i32) -> i32 {
+    if !crate::shared_pages::committed_aliases_enabled() {
+        return free();
+    }
+    let mut aliases = COMMITTED.write().unwrap_or_else(|e| e.into_inner());
+    let result = free();
+    if result == 0 {
+        return result;
+    }
+    let base = base as u64;
+    let released: Vec<_> = if len == 0 {
+        aliases.remove(&base).into_iter().map(|a| (base, a)).collect()
+    } else {
+        let end = base.saturating_add(len as u64);
+        let starts: Vec<_> = aliases.range(..end)
+            .filter(|&(&at, a)| at + a.len > base)
+            .map(|(&at, _)| at)
+            .collect();
+        starts.into_iter().filter_map(|at| aliases.remove(&at).map(|a| (at, a))).collect()
+    };
+    drop(aliases);
+    for (at, allocation) in released {
+        let end = at + allocation.len;
+        let mut retired = Vec::new();
+        {
+            let mut entries = buffers();
+            for (_, entry) in entries.range_mut((at, 0)..(end, 0)) {
+                if entry.shadow.as_ref().is_some_and(|shadow| shadow.buffer == allocation.buffer) {
+                    retired.extend(entry.shadow.take());
+                }
+            }
+        }
+        for shadow in retired {
+            crate::host::retire(shadow);
+        }
+    }
+    result
+}
