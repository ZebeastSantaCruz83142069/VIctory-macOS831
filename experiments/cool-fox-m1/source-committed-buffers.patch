+/// # Safety
+/// The destination is the caller's view. The source and its owner are
+/// kept alive for all uses of the new mapping.
+pub(crate) unsafe fn overlay(at: usize, source: usize, len: usize) -> bool {
+    // SAFETY: the caller owns both mapped ranges and retains the source.
+    let remap = unsafe {
+        mach::remap_shared(
+            at as u64,
+            source as u64,
+            len as u64,
+            mach::VM_FLAGS_FIXED | mach::VM_FLAGS_OVERWRITE,
+        )
+    };
+    remap.msg == 0 && remap.kr == 0 && remap.address == at as u64
+}
