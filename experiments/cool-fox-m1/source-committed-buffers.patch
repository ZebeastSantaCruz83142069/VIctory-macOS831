+    #[cfg(feature = "diagnostics")]
+    #[test]
+    #[ignore = "requires D3DMetal with VICTORY_COMMITTED_ALIAS=1"]
+    fn committed_title_buffer_shares_a_subrange_until_release() {
+        use crate::shadow::{
+            find, free_committed_allocation, register, share_committed_allocation, unregister,
+        };
+        use std::sync::Arc;
+
+        let host = crate::host::host().expect("D3D12 host");
+        let mut rig = Rig::new(&host.device).unwrap();
+        // SAFETY: test-owned memory. The test releases it below.
+        let base = unsafe {
+            mem::VirtualAlloc(
+                std::ptr::null(),
+                2 * K64,
+                mem::MEM_COMMIT | mem::MEM_RESERVE,
+                mem::PAGE_READWRITE,
+            )
+        };
+        assert!(!base.is_null());
+        // SAFETY: exclusive, newly committed pages.
+        assert!(unsafe { share_committed_allocation(base as usize, 2 * K64) });
+        let bias = K64 + 256;
+        let address = base.wrapping_byte_add(bias);
+        let va = address as u64;
+        register(va as usize, va, 4096);
+        let shadow = find(va, 32).unwrap();
+        assert!(shadow.in_place());
+        assert_eq!(shadow.left(va), 4096);
+        assert_eq!(shadow.offset(va), bias as u64);
+        let fetch = |rig: &mut Rig| rig.fetch(&shadow.buffer, shadow.offset(va), 32).unwrap();
+        assert_eq!(fetch(&mut rig), [0; 32]);
+        // SAFETY: the first 32 bytes of the test view, with no GPU access in flight.
+        unsafe { address.cast::<u8>().write_bytes(0x5A, 32) };
+        assert_eq!(fetch(&mut rig), [0x5A; 32]);
+        rig.store(&shadow.buffer, shadow.offset(va), &[0xB7; 32]).unwrap();
+        // SAFETY: the preceding GPU submission was completed before this read.
+        assert_eq!(unsafe { address.cast::<[u8; 32]>().read() }, [0xB7; 32]);
+
+        // SAFETY: the test owns this allocation. A nonzero release size is invalid.
+        let failed = free_committed_allocation(base as usize, K64, || unsafe {
+            mem::VirtualFree(base, K64, mem::MEM_RELEASE)
+        });
+        assert_eq!(failed, 0);
+        assert!(Arc::ptr_eq(&shadow, &find(va, 32).unwrap()));
+        // SAFETY: release this test's whole allocation and keep the old GPU resource alive.
+        let released = free_committed_allocation(base as usize, 0, || unsafe {
+            mem::VirtualFree(base, 0, mem::MEM_RELEASE)
+        });
+        assert_ne!(released, 0);
+        assert!(crate::shadow::peek(va, 32).is_none());
+        assert_eq!(fetch(&mut rig), [0xB7; 32]);
+        unregister(va as usize, va);
+    }
