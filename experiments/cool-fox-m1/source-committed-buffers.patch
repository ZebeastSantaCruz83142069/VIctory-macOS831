+pub(crate) fn committed_aliases_enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        crate::switch::on("VICTORY_COMMITTED_ALIAS") && physical_heaps_enabled()
+    })
