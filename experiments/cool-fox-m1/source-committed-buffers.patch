+#[cfg(feature = "diagnostics")]
+struct CommittedAllocation {
+    buffer: ID3D12Resource,
+    cpu: usize,
+    gpu: u64,
+    len: u64,
+}
+
+#[cfg(feature = "diagnostics")]
+static COMMITTED: RwLock<BTreeMap<u64, CommittedAllocation>> = RwLock::new(BTreeMap::new());
+
+#[cfg(feature = "diagnostics")]
+fn committed_shadow(at: u64, len: u64) -> Option<Arc<Shadow>> {
+    let aliases = COMMITTED.read().unwrap_or_else(|e| e.into_inner());
+    let (&base, allocation) = aliases.range(..=at).next_back()?;
+    let bias = at - base;
+    if len > allocation.len.checked_sub(bias)? {
+        return None;
+    }
+    let mut shadow = Shadow::new(
+        allocation.buffer.clone(),
+        (allocation.cpu + bias as usize) as *mut u8,
+        allocation.gpu + bias,
+        at,
+        len,
+    );
+    shadow.keep_in_place(None, bias, false);
+    let _ = shadow.width.set(allocation.len.min(bias + len.next_multiple_of(PAGE as u64)));
+    Some(Arc::new(shadow))
+}
