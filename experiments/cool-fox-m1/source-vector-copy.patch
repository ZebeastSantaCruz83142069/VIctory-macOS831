From 8d453c80a15103dd75d5c701e05f9d1848f91897 Mon Sep 17 00:00:00 2001
From: ZebeastSantaCruz83142069
 <361184274+ZebeastSantaCruz83142069@users.noreply.github.com>
Date: Thu, 26 Nov 2026 03:57:07 -0800
Subject: [PATCH] Add opt-in aligned SSE2 bulk copies for CrossOver on Apple
 Silicon

---
 crates/victory-gpu/src/safecopy.rs | 82 ++++++++++++++++++++++++++++--
 1 file changed, 78 insertions(+), 4 deletions(-)

diff --git a/crates/victory-gpu/src/safecopy.rs b/crates/victory-gpu/src/safecopy.rs
index 66bb68a..5825682 100644
--- a/crates/victory-gpu/src/safecopy.rs
+++ b/crates/victory-gpu/src/safecopy.rs
@@ -6,7 +6,8 @@
 //! page instead of faulting: some 35,000 calls a frame, each of which locks
 //! the pages it copies, 39 ms of kernel time on the submitting thread alone.
 //!
-//! [`copy`] is one `rep movsb`. A fault in it is taken by the handler of
+//! [`copy`] uses `rep movsb`. With `VICTORY_VECTOR_COPY=1`, aligned bulk
+//! copies use SSE2. A fault in either path is taken by the handler of
 //! [`crate::watch`] (`on_write`, the first in the process), which opens a
 //! block we guard ourselves and lets the copy go on, and otherwise sends it
 //! to its failing exit. `VICTORY_SAFE_COPY=0`: through the kernel, as before.
@@ -18,7 +19,7 @@ std::arch::global_asm!(
     ".globl victory_safe_copy_at",
     ".globl victory_safe_copy_after",
     ".globl victory_safe_copy_failed",
-    // rcx destination, rdx source, r8 bytes; eax: whether all were copied.
+    // rcx destination, rdx source, r8 bytes, r9d enables aligned vector copies.
     // A leaf that leaves the stack alone (the two registers it must give
     // back are kept in volatile ones), so a stack walk through it works.
     "victory_safe_copy:",
@@ -27,7 +28,37 @@ std::arch::global_asm!(
     "mov rdi, rcx",
     "mov rsi, rdx",
     "mov rcx, r8",
+    "test r9d, r9d",
+    "jz .Lcopy_bytes",
+    // Each vector access stays within a page. Alternate loads and stores
+    // so that earlier accessible bytes are copied before a later fault.
+    "mov rax, rdi",
+    "or rax, rsi",
+    "test al, 15",
+    "jnz .Lcopy_bytes",
+    // Keep forward byte-copy semantics for overlapping ranges.
+    "mov rax, rdi",
+    "sub rax, rsi",
+    "cmp rax, rcx",
+    "jb .Lcopy_bytes",
+    "cmp rcx, 64",
+    "jb .Lcopy_bytes",
     "victory_safe_copy_at:",
+    ".Lcopy_vectors:",
+    "movdqa xmm0, [rsi]",
+    "movdqa [rdi], xmm0",
+    "movdqa xmm0, [rsi + 16]",
+    "movdqa [rdi + 16], xmm0",
+    "movdqa xmm0, [rsi + 32]",
+    "movdqa [rdi + 32], xmm0",
+    "movdqa xmm0, [rsi + 48]",
+    "movdqa [rdi + 48], xmm0",
+    "add rsi, 64",
+    "add rdi, 64",
+    "sub rcx, 64",
+    "cmp rcx, 64",
+    "jae .Lcopy_vectors",
+    ".Lcopy_bytes:",
     "rep movsb",
     "victory_safe_copy_after:",
     "mov eax, 1",
@@ -137,7 +168,7 @@ std::arch::global_asm!(
 );
 
 unsafe extern "system" {
-    fn victory_safe_copy(dst: *mut u8, src: *const u8, len: usize) -> u32;
+    fn victory_safe_copy(dst: *mut u8, src: *const u8, len: usize, vectors: u32) -> u32;
     fn victory_safe_copy_at();
     fn victory_safe_copy_after();
     fn victory_safe_copy_failed();
@@ -338,9 +369,11 @@ pub(crate) fn on() -> bool {
 /// Of the two ranges, what is not title memory must be valid, and no Rust
 /// reference may cover the destination. [`on`] must have been asked.
 pub(crate) unsafe fn copy(dst: *mut u8, src: *const u8, len: usize) -> bool {
+    static VECTORS: OnceLock<bool> = OnceLock::new();
+    let vectors = len >= 64 && *VECTORS.get_or_init(|| std::env::var_os("VICTORY_VECTOR_COPY").is_some_and(|s| s == "1"));
     // SAFETY: a fault on either side leaves through the failing exit
     // ([`failing_exit`]); the rest is the caller's.
-    unsafe { victory_safe_copy(dst, src, len) != 0 }
+    unsafe { victory_safe_copy(dst, src, len, u32::from(vectors)) != 0 }
 }
 
 /// For the fault handler: where a fault at instruction `at` is to go on, if
@@ -409,6 +442,47 @@ mod tests {
         }
     }
 
+    #[test]
+    fn vector_copy_matches_forward_bytes_for_overlap_and_tails() {
+        assert!(on());
+        let page = Pages::new(4096);
+        for (from, to) in [(32, 0), (16, 32), (16, 16), (5, 7), (0, 512)] {
+            for len in [0, 63, 64, 65, 176, 255] {
+                let mut expected: Vec<_> = (0..4096).map(|i| (i ^ (i >> 4)) as u8).collect();
+                // SAFETY: both ranges and all their tails are in our allocation.
+                unsafe {
+                    std::ptr::copy_nonoverlapping(expected.as_ptr(), page.0, expected.len());
+                    for i in 0..len {
+                        expected[to + i] = expected[from + i];
+                    }
+                    assert_ne!(victory_safe_copy(page.0.add(to), page.0.add(from), len, 1), 0);
+                    assert_eq!(std::slice::from_raw_parts(page.0, expected.len()), expected);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn vector_copy_preserves_the_prefix_at_a_page_boundary() {
+        assert!(on());
+        let (source, dest) = (Pages::new(8192), Pages::new(8192));
+        source.fill();
+        // SAFETY: both allocations are ours. Only the copy under test
+        // accesses the page while it is inaccessible.
+        unsafe {
+            for invalid in [source.0, dest.0] {
+                std::ptr::write_bytes(dest.0, 0xee, 8192);
+                let mut old = 0;
+                assert_ne!(VirtualProtect(invalid.add(4096).cast(), 4096, PAGE_NOACCESS, &mut old), 0);
+                assert_eq!(victory_safe_copy(dest.0.add(16), source.0.add(16), 4097, 1), 0);
+                assert_ne!(VirtualProtect(invalid.add(4096).cast(), 4096, old, &mut old), 0);
+                let got = std::slice::from_raw_parts(dest.0, 8192);
+                assert!(got[..16].iter().chain(&got[4096..]).all(|&v| v == 0xee));
+                assert_eq!(&got[16..4096], std::slice::from_raw_parts(source.0.add(16), 4080));
+            }
+        }
+    }
+
     /// The dwords that changed are stored, and no byte of any other, at
     /// every alignment and length; a page that is not there fails.
     #[test]
-- 
