index be473764dffb3b4ccfd0cf1da7fb448f0cb0a99c..2168f87b409464c9134970bae70b09632fda99d1 100644
--- a/crates/victory-gpu/src/compose.rs
+++ b/crates/victory-gpu/src/compose.rs
@@ -10,6 +10,30 @@ use windows::core::{PCSTR, s};
 
 use crate::host::Host;
 
+/// Optional presentation of the game's own scene radiance before post-processing.
+/// Hold only completed captures. A menu or a movie ages the last scene out.
+static SCENE_COLOR: std::sync::Mutex<Option<(u64, ID3D12Resource)>> = std::sync::Mutex::new(None);
+
+pub(crate) fn scene_color_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("VICTORY_PRESENT_SCENE_COLOR").is_some_and(|v| v == "1"))
+}
+
+pub(crate) fn finish_scene_color(texture: ID3D12Resource) {
+    let mut scene = SCENE_COLOR.lock().unwrap_or_else(|e| e.into_inner());
+    *scene = Some((crate::queue::presented(), texture));
+}
+
+pub(crate) fn scene_color(frame: u64) -> Option<ID3D12Resource> {
+    let mut scene = SCENE_COLOR.lock().unwrap_or_else(|e| e.into_inner());
+    let (captured, texture) = scene.as_ref()?;
+    if frame.abs_diff(*captured) <= 2 {
+        return Some(texture.clone());
+    }
+    *scene = None;
+    None
+}
+
 const SOURCE: &str = r#"
 Texture2D<float4> scene : register(t0);
 Texture2D<float4> over : register(t1);
