+    /// Times repeated refreshes of a buffer with a long committed prefix.
+    /// Both strategies must copy fresh edge bytes and recover a newly filled hole.
+    #[test]
+    #[ignore = "CrossOver buffer-copy measurement"]
+    fn repeated_sparse_prefix_cost() {
+        use windows_sys::Win32::System::Memory::*;
+        const SIZE: usize = 16 << 20;
+        const BLOCK: usize = 64 << 10;
+        unsafe {
+            let base = VirtualAlloc(std::ptr::null(), SIZE, MEM_RESERVE, PAGE_NOACCESS).cast::<u8>();
+            assert!(!base.is_null());
+            let hole = SIZE - 2 * BLOCK;
+            for (offset, len) in [(0, hole), (hole + BLOCK, BLOCK)] {
+                let p = base.add(offset);
+                assert_eq!(VirtualAlloc(p.cast(), len, MEM_COMMIT, PAGE_READWRITE), p.cast());
+                p.write_bytes(0x6b, len);
+            }
+            let mut output = vec![0u8; SIZE];
+            super::copy_mapped(output.as_mut_ptr(), base, SIZE, false);
+            let mut times = Vec::new();
+            for round in 1..=21u8 {
+                base.write(round);
+                base.add(SIZE - 1).write(round);
+                let start = std::time::Instant::now();
+                super::copy_mapped(output.as_mut_ptr(), base, SIZE, false);
+                times.push(start.elapsed().as_micros());
+                assert_eq!((output[0], output[SIZE - 1]), (round, round));
+            }
+            assert!(output[1..hole].iter().all(|&v| v == 0x6b));
+            assert!(output[hole..hole + BLOCK].iter().all(|&v| v == 0));
+            assert!(output[hole + BLOCK..SIZE - 1].iter().all(|&v| v == 0x6b));
+            let p = base.add(hole);
+            assert_eq!(VirtualAlloc(p.cast(), BLOCK, MEM_COMMIT, PAGE_READWRITE), p.cast());
+            p.write_bytes(0xab, BLOCK);
+            super::copy_mapped(output.as_mut_ptr(), base, SIZE, false);
+            assert!(output[hole..hole + BLOCK].iter().all(|&v| v == 0xab));
+            times.sort_unstable();
+            eprintln!("median sparse refresh (16 MiB, 21 copies): {} us", times[10]);
+            assert_ne!(VirtualFree(base.cast(), 0, MEM_RELEASE), 0);
+        }
+    }
+
     use super::*;
 
