+    let whole = !walk_first && (read(src, dst, len) || title_dst && crate::watch::again_after_change(since, || read(src, dst, len)));
     #[cfg(feature = "diagnostics")]
     crate::copystat::add(crate::copystat::C::MoveUs, moved.elapsed().as_micros() as u64);
     if whole {
