-/// After a failed bulk read into host memory, skip contiguous holes. Never
-/// cache the query across copies: the title may remap the same address.
-fn read_sparse(src: *const u8, dst: *mut u8, len: usize) {
+// Only the preferred read strategy survives a copy. The next copy queries
+// current protections and reads current bytes even on an exact hit.
+thread_local! {
+    static SPARSE_HINTS: std::cell::RefCell<[(usize, usize); 64]> =
+        const { std::cell::RefCell::new([(0, 0); 64]) };
+}
+
+fn sparse_hints_enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("VICTORY_SPARSE_HINTS").is_some_and(|v| v == "1"))
+}
+
+/// Walk current regions. Report whether a later copy should walk first to
+/// avoid copying a long readable prefix twice before reaching the first hole.
+fn read_sparse(src: *const u8, dst: *mut u8, len: usize) -> bool {
     use windows_sys::Win32::System::Memory::{
         MEM_COMMIT, MEMORY_BASIC_INFORMATION, PAGE_NOACCESS, VirtualQuery,
     };
     let mut offset = 0;
+    let mut sparse = false;
     while offset < len {
         let at = src.wrapping_add(offset);
         let to = dst.wrapping_add(offset);
@@ -8317,19 +8379,22 @@ fn read_sparse(src: *const u8, dst: *mut u8, len: usize) {
             .saturating_sub(at as usize).min(remaining);
         if size != size_of_val(&info) || n == 0 {
             read_pieces(at, to, remaining);
-            break;
+            return true;
         }
         if info.State != MEM_COMMIT || info.Protect == PAGE_NOACCESS {
+            sparse = true;
             #[cfg(feature = "diagnostics")]
             crate::copystat::add(crate::copystat::C::Unmapped, n as u64);
             // SAFETY: this path is only used with a writable host destination.
             unsafe { to.write_bytes(0, n) };
         } else if !read(at, to, n) {
+            sparse = true;
             // A mapping may change between query and read.
             read_pieces(at, to, n);
         }
         offset += n;
     }
+    sparse
 }
 
 fn read_pieces(src: *const u8, dst: *mut u8, len: usize) {
