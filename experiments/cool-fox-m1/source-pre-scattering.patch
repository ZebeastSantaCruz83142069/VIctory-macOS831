 use windows::Win32::Foundation::RECT;
 use windows::Win32::Graphics::Direct3D::D3D_PRIMITIVE_TOPOLOGY;
 use windows::Win32::Graphics::Direct3D12::*;
-use windows::Win32::Graphics::Dxgi::Common::DXGI_FORMAT;
+use windows::Win32::Graphics::Dxgi::Common::{DXGI_FORMAT, DXGI_FORMAT_R11G11B10_FLOAT, DXGI_FORMAT_R16G16B16A16_FLOAT};
 use windows::core::Interface;
 
 use crate::host::HostList;
@@ -3153,6 +3153,15 @@ impl State {
                 unsafe { list.list.SetComputeRoot32BitConstant(param, threads[0], word) };
             }
         }
+        // Snapshot the real HDR scene before the atmosphere shader reads and writes it.
+        // The title still runs that dispatch and every later render pass.
+        if crate::compose::scene_source() == crate::compose::SceneSource::BeforeScattering
+            && p.stages.first().is_some_and(|stage| stage.shader.hash == "577248728544d74b")
+            && let Some(Root::Table(table)) = self.roots_ref(true).get(1)
+            && let Some(View::Unordered(resource, ..)) = crate::descriptor::view(table + 48 * 4)
+        {
+            list.copy_scene_color(resource as This, DXGI_FORMAT_R16G16B16A16_FLOAT);
+        }
         #[cfg(feature = "diagnostics")]
         let world_color = p.stages.first()
             .and_then(|stage| crate::capture::lighting::select(&stage.shader.hash))
@@ -3175,15 +3184,14 @@ impl State {
         }
         self.buffers_written();
         DISPATCHED.fetch_add(1, Ordering::Relaxed);
-        if crate::compose::scene_color_enabled()
+        if crate::compose::scene_source() == crate::compose::SceneSource::Radiance
             && p.stages.first().and_then(|s| s.shader.ambient) == Some(crate::ambient::Role::Radiance)
         {
             let (slot, offset) = crate::ambient::RADIANCE;
             if let Some(Root::Table(table)) = self.roots_ref(true).get(usize::from(slot))
                 && let Some(View::Unordered(resource, ..)) = crate::descriptor::view(table + u64::from(offset) * 4)
-                && let Some(source) = crate::resource::host_copy(resource as This)
             {
-                list.copy_scene_color(&source);
+                list.copy_scene_color(resource as This, DXGI_FORMAT_R11G11B10_FLOAT);
             }
         }
         if let Some(role) = p.stages.first().and_then(|s| s.shader.ambient)
diff --git a/crates/victory-gpu/src/host.rs b/crates/victory-gpu/src/host.rs
index e778906..d5326b1 100644
--- a/crates/victory-gpu/src/host.rs
+++ b/crates/victory-gpu/src/host.rs
@@ -7170,16 +7170,35 @@ impl HostList {
         }
     }
 
-    /// Snapshot the shaded scene on the producing command list, after the title's
-    /// radiance dispatch. The presenter only receives it when this list finishes.
-    pub(crate) fn copy_scene_color(&self, source: &crate::resource::HostTexture) {
+    /// Snapshot a bound scene UAV at its place in the producing list.
+    /// The presenter receives the copy after the submission fence completes.
+    pub(crate) fn copy_scene_color(&self, resource: crate::object::This, format: DXGI_FORMAT) {
+        let Some(source) = crate::resource::host_copy(resource) else { return };
         let Some(host) = host() else { return };
+        let key = std::sync::Arc::as_ptr(&source) as usize;
+        let state = self.states.lock().unwrap_or_else(|e| e.into_inner())
+            .get(&key).map_or(D3D12_RESOURCE_STATE_UNORDERED_ACCESS.0 as u32, |entry| entry.1);
+        self.transition(resource, state);
+        if let Some(copy) = self.snapshot_scene_texture(
+            &host.device, &source.texture, format, D3D12_RESOURCE_STATES(state as i32),
+        ) {
+            self.deferred().scene_color = Some(copy);
+        }
+    }
+
+    pub(crate) fn snapshot_scene_texture(
+        &self,
+        device: &ID3D12Device,
+        source: &ID3D12Resource,
+        format: DXGI_FORMAT,
+        state: D3D12_RESOURCE_STATES,
+    ) -> Option<ID3D12Resource> {
         // SAFETY: the source is a live texture retained by this command list.
-        let mut desc = unsafe { source.texture.GetDesc() };
-        if desc.Format != DXGI_FORMAT_R11G11B10_FLOAT || desc.MipLevels != 1
+        let mut desc = unsafe { source.GetDesc() };
+        if desc.Format != format || desc.MipLevels != 1
             || desc.DepthOrArraySize != 1 || desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || desc.SampleDesc.Count != 1
         {
-            return;
+            return None;
         }
         desc.Flags = D3D12_RESOURCE_FLAG_NONE;
         desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
@@ -7189,22 +7208,21 @@ impl HostList {
         // SAFETY: matching texture shape and format. Restore the title texture's
         // tracked state, and retain both resources until GPU completion.
         unsafe {
-            if host.device.CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST, None, &mut copy).is_err() {
-                return;
+            if device.CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST, None, &mut copy).is_err() {
+                return None;
             }
-            let Some(copy) = copy else { return };
-            let state = D3D12_RESOURCE_STATES(source.state.load(Ordering::Relaxed) as i32);
+            let Some(copy) = copy else { return None };
             if state != D3D12_RESOURCE_STATE_COPY_SOURCE {
-                self.list.ResourceBarrier(&[transition(&source.texture, state, D3D12_RESOURCE_STATE_COPY_SOURCE)]);
+                self.list.ResourceBarrier(&[transition(source, state, D3D12_RESOURCE_STATE_COPY_SOURCE)]);
             }
-            self.list.CopyResource(&copy, &source.texture);
+            self.list.CopyResource(&copy, source);
             self.list.ResourceBarrier(&[transition(&copy, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE)]);
             if state != D3D12_RESOURCE_STATE_COPY_SOURCE {
-                self.list.ResourceBarrier(&[transition(&source.texture, D3D12_RESOURCE_STATE_COPY_SOURCE, state)]);
+                self.list.ResourceBarrier(&[transition(source, D3D12_RESOURCE_STATE_COPY_SOURCE, state)]);
             }
-            self.keep(&source.texture);
+            self.keep(source);
             self.keep(&copy);
-            self.deferred().scene_color = Some(copy);
+            Some(copy)
         }
     }
 
@@ -9086,9 +9104,10 @@ impl Host {
                 let early = crate::compose::scene_color_enabled().then(|| crate::compose::scene_color(frame)).flatten();
                 let (texture, state, base_fmt) = if let Some(ref scene) = early {
                     static LOGGED: std::sync::Once = std::sync::Once::new();
-                    LOGGED.call_once(|| tracing::info!(frame, "presenting the title's scene radiance with sRGB encoding under its UI"));
+                    let format = scene.GetDesc().Format;
+                    LOGGED.call_once(|| tracing::info!(frame, ?format, source = ?crate::compose::scene_source(), "presenting the completed scene texture under the title UI"));
                     copy.keep(scene);
-                    (scene, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, DXGI_FORMAT_R11G11B10_FLOAT)
+                    (scene, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, format)
                 } else {
                     (texture, state, base_fmt)
                 };
