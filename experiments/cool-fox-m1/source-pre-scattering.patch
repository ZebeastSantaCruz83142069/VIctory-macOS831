 crates/victory-gpu/src/draw.rs             | 16 +++++--
 crates/victory-gpu/src/host.rs             | 53 +++++++++++++++-------
 4 files changed, 84 insertions(+), 31 deletions(-)

diff --git a/crates/victory-gpu/src/capture/lighting.rs b/crates/victory-gpu/src/capture/lighting.rs
index 1d63e1c..507983a 100644
--- a/crates/victory-gpu/src/capture/lighting.rs
+++ b/crates/victory-gpu/src/capture/lighting.rs
@@ -192,6 +192,13 @@ mod tests {
                 .ClearRenderTargetView(rtv, &[0.5, 0., 0., 1.], Some(&[bottom]))
         };
         let after = record(&host.device, &list.list, &surface, state).expect("after readback");
+        let snapshot = list.snapshot_scene_texture(
+            &host.device, &surface, DXGI_FORMAT_R16G16B16A16_FLOAT, state,
+        ).expect("snapshot of the colored pixels");
+        unsafe { list.list.ClearRenderTargetView(rtv, &[0.; 4], None) };
+        let preserved = record(&host.device, &list.list, &snapshot, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE)
+            .expect("snapshot readback after overwriting the original");
+        let cleared = record(&host.device, &list.list, &surface, state).expect("original after clear");
         list.close();
         host.execute(&[&list]);
         let a = before.counts().unwrap();
@@ -205,5 +212,7 @@ mod tests {
             (3, 3, 0)
         );
         assert_ne!(a.rgba_hash, b.rgba_hash);
+        assert_eq!(preserved.counts().unwrap().rgba_hash, b.rgba_hash);
+        assert_eq!(cleared.counts().unwrap().positive_rgb, 0);
     }
 }
diff --git a/crates/victory-gpu/src/compose.rs b/crates/victory-gpu/src/compose.rs
index 46a6aad..4c8dc19 100644
--- a/crates/victory-gpu/src/compose.rs
+++ b/crates/victory-gpu/src/compose.rs
@@ -14,9 +14,24 @@ use crate::host::Host;
 /// Hold only completed captures. A menu or a movie ages the last scene out.
 static SCENE_COLOR: std::sync::Mutex<Option<(u64, ID3D12Resource)>> = std::sync::Mutex::new(None);
 
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum SceneSource {
+    DisplayPlane,
+    Radiance,
+    BeforeScattering,
+}
+
+pub(crate) fn scene_source() -> SceneSource {
+    static SOURCE: std::sync::OnceLock<SceneSource> = std::sync::OnceLock::new();
+    *SOURCE.get_or_init(|| match std::env::var("VICTORY_PRESENT_SCENE_COLOR").as_deref() {
+        Ok("1") => SceneSource::Radiance,
+        Ok("before-scattering") => SceneSource::BeforeScattering,
+        _ => SceneSource::DisplayPlane,
+    })
+}
+
 pub(crate) fn scene_color_enabled() -> bool {
-    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
-    *ENABLED.get_or_init(|| std::env::var_os("VICTORY_PRESENT_SCENE_COLOR").is_some_and(|v| v == "1"))
+    scene_source() != SceneSource::DisplayPlane
 }
 
 pub(crate) fn finish_scene_color(texture: ID3D12Resource) {
@@ -415,15 +430,17 @@ mod tests {
         let mut ui = [[0.0; 4]; 10];
         ui[8] = [0.25, 0.0, 0.0, 0.5];
         ui[9] = [0.25, 0.5, 0.75, 1.0];
-        let pixels = composite(host, DXGI_FORMAT_R11G11B10_FLOAT, &colors, &ui, true);
-        let mut expected = [0u8, 6, 13, 34, 118, 188, 255, 255, 0, 0].map(|v| [v, v, v, 255]);
-        expected[8] = [158, 94, 94, 255];
-        expected[9] = [64, 128, 191, 255];
-        for (actual, reference) in pixels.chunks_exact(4).zip(expected) {
-            for (v, r) in actual.iter().zip(reference) {
-                assert!(v.abs_diff(r) <= 2, "unexpected SDR ramp {pixels:?}");
+        for format in [DXGI_FORMAT_R11G11B10_FLOAT, DXGI_FORMAT_R16G16B16A16_FLOAT] {
+            let pixels = composite(host, format, &colors, &ui, true);
+            let mut expected = [0u8, 6, 13, 34, 118, 188, 255, 255, 0, 0].map(|v| [v, v, v, 255]);
+            expected[8] = [158, 94, 94, 255];
+            expected[9] = [64, 128, 191, 255];
+            for (actual, reference) in pixels.chunks_exact(4).zip(expected) {
+                for (v, r) in actual.iter().zip(reference) {
+                    assert!(v.abs_diff(r) <= 2, "unexpected SDR ramp {pixels:?}");
+                }
             }
+            eprintln!("D3D12 {format:?} scene ramp and HUD readback RGBA: {pixels:?}");
         }
-        eprintln!("D3D12 radiance ramp and HUD readback RGBA: {pixels:?}");
     }
 }
