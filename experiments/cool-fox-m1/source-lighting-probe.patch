+
+    #[cfg(feature = "diagnostics")]
+    pub(crate) fn probe_world_color(
+        &self,
+        resource: crate::object::This,
+        probe: crate::capture::lighting::Probe,
+        side: &'static str,
+    ) {
+        let Some(source) = crate::resource::host_copy(resource) else { return };
+        let key = std::sync::Arc::as_ptr(&source) as usize;
+        let state = self.states.lock().unwrap_or_else(|e| e.into_inner())
+            .get(&key).map(|entry| entry.1);
+        // A UAV binding requires the unordered-access state. If this is the
+        // list's first tracked use, the submission prelude establishes it.
+        let state = state.unwrap_or(D3D12_RESOURCE_STATE_UNORDERED_ACCESS.0 as u32);
+        self.transition(resource, state);
+        let Some(host) = host() else { return };
+        if let Some(sample) = crate::capture::lighting::record(
+            &host.device, &self.list, &source.texture, D3D12_RESOURCE_STATES(state as i32),
+        ) {
+            // Lists may be submitted again after the first fence was read.
+            self.keep(&sample.buffer);
+            self.deferred().lighting.push((probe, side, sample));
+        }
+    }
