+//! Fixed edits to live executable code before the title starts.
+
+use windows_sys::Win32::System::Diagnostics::Debug::FlushInstructionCache;
+use windows_sys::Win32::System::Memory::{PAGE_EXECUTE_READWRITE, VirtualProtect};
+use windows_sys::Win32::System::Threading::GetCurrentProcess;
+
+/// Replaces matching bytes in a mapped executable.
+///
+/// # Safety
+/// `at` must point to a readable executable range of at least
+/// `original.len()` bytes, with no title threads executing it yet.
+pub unsafe fn patch_code(at: *mut u8, original: &[u8], replacement: &[u8]) -> bool {
+    if original.is_empty() || original.len() != replacement.len() {
+        return false;
+    }
+    // SAFETY: the caller supplied the readable code range before execution.
+    if unsafe { std::slice::from_raw_parts(at, original.len()) } != original {
+        return false;
+    }
+    let mut old = 0;
+    // SAFETY: the code is live and idle, and the protection and cache
+    // operations address the same range as the write.
+    unsafe {
+        if VirtualProtect(at.cast(), original.len(), PAGE_EXECUTE_READWRITE, &mut old) == 0 {
+            return false;
+        }
+        std::ptr::copy_nonoverlapping(replacement.as_ptr(), at, replacement.len());
+        let mut ignored = 0;
+        let restored = VirtualProtect(at.cast(), original.len(), old, &mut ignored) != 0;
+        let flushed = FlushInstructionCache(GetCurrentProcess(), at.cast(), original.len()) != 0;
+        restored && flushed
+    }
+}
