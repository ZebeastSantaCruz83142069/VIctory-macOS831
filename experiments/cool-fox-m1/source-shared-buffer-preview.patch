+
+/// Shares the backing of a newly committed title allocation with D3DMetal.
+///
+/// # Safety
+/// The range is exclusively owned, freshly committed and read-write.
+#[cfg(feature = "diagnostics")]
+pub unsafe fn share_committed_allocation(base: usize, len: usize) -> bool {
+    const GRANULE: usize = 64 << 10;
+    if !crate::shared_pages::committed_aliases_enabled()
+        || base == 0
+        || len == 0
+        || !base.is_multiple_of(GRANULE)
+        || !len.is_multiple_of(GRANULE)
+        || base.checked_add(len).is_none()
+    {
+        return false;
+    }
+    let Some((buffer, cpu)) = host().and_then(|host| host.shared_buffer(len as u64)) else {
+        return false;
+    };
+    // SAFETY: the fresh buffer is mapped for this length. Preserve the
+    // initial zeros that VirtualAlloc guarantees to the caller.
+    unsafe { cpu.write_bytes(0, len) };
+    // SAFETY: the destination is fresh and the registry retains the buffer.
+    if !unsafe { crate::shared_pages::overlay(base, cpu as usize, len) } {
+        return false;
+    }
+    // SAFETY: a live host buffer.
+    let gpu = unsafe { buffer.GetGPUVirtualAddress() };
+    COMMITTED.write().unwrap_or_else(|e| e.into_inner()).insert(
+        base as u64,
+        CommittedAllocation {
+            buffer,
+            cpu: cpu as usize,
+            gpu,
+            len: len as u64,
+        },
+    );
+    if len >= 16 << 20 {
+        tracing::info!(base = format_args!("{base:#x}"), len, "committed title buffer uses shared memory");
+    }
+    true
+}
