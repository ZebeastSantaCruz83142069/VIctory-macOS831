+pub fn free_committed_allocation(base: usize, len: usize, free: impl FnOnce() -> i32) -> i32 {
+    if !crate::shared_pages::committed_aliases_enabled() {
+        return free();
+    }
+    let mut aliases = COMMITTED.write().unwrap_or_else(|e| e.into_inner());
+    let result = free();
+    if result == 0 {
+        return result;
+    }
+    let base = base as u64;
+    let released: Vec<_> = if len == 0 {
+        aliases.remove(&base).into_iter().map(|a| (base, a)).collect()
+    } else {
+        let end = base.saturating_add(len as u64);
