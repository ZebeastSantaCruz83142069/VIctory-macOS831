-        let state = state.unwrap_or(D3D12_RESOURCE_STATE_UNORDERED_ACCESS.0 as u32);
+        // On first use the submission prelude establishes the binding state.
+        let state = state.unwrap_or(binding_state.0 as u32);
         self.transition(resource, state);
         let Some(host) = host() else { return };
         if let Some(sample) = crate::capture::lighting::record(
@@ -7214,12 +7214,12 @@ impl HostList {
 
     /// Snapshot a bound scene UAV at its place in the producing list.
     /// The presenter receives the copy after the submission fence completes.
-    pub(crate) fn copy_scene_color(&self, resource: crate::object::This, format: DXGI_FORMAT) {
+    pub(crate) fn copy_scene_color(&self, resource: crate::object::This, format: DXGI_FORMAT, binding_state: D3D12_RESOURCE_STATES) {
         let Some(source) = crate::resource::host_copy(resource) else { return };
         let Some(host) = host() else { return };
         let key = std::sync::Arc::as_ptr(&source) as usize;
         let state = self.states.lock().unwrap_or_else(|e| e.into_inner())
-            .get(&key).map_or(D3D12_RESOURCE_STATE_UNORDERED_ACCESS.0 as u32, |entry| entry.1);
+            .get(&key).map_or(binding_state.0 as u32, |entry| entry.1);
         self.transition(resource, state);
         if let Some(copy) = self.snapshot_scene_texture(
             &host.device, &source.texture, format, D3D12_RESOURCE_STATES(state as i32),
