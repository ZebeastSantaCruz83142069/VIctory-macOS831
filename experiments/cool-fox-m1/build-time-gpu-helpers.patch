+++ b/crates/victory-gpu/build.rs
@@ -16,6 +16,49 @@ fn files(dir: &Path, out: &mut Vec<PathBuf>) {
 }
 
 fn main() {
+    println!("cargo:rustc-check-cfg=cfg(victory_dxc_compare)");
+    println!("cargo:rerun-if-env-changed=VICTORY_HELPER_DXC");
+    println!("cargo:rerun-if-env-changed=DXC_EXE");
+    println!("cargo:rerun-if-changed=src/card-compare.hlsl");
+    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() == Ok("windows")
+        && let Some(compiler) = std::env::var_os("VICTORY_HELPER_DXC")
+    {
+        let out = PathBuf::from(std::env::var_os("OUT_DIR").unwrap());
+        let compile = |source: &Path, name: &str, profile: &str, entry: &str| {
+            let status = std::process::Command::new(&compiler)
+                .args(["-T", profile, "-E", entry, "-Fo"])
+                .arg(out.join(format!("{name}.dxil")))
+                .arg(source)
+                .status()
+                .expect("start DXC to compile GPU helper shaders");
+            assert!(status.success(), "DXC failed to compile {name}");
+        };
+        for (name, profile, entry) in [
+            ("card-compare", "cs_6_0", "main"), ("indirect-clamp", "cs_6_0", "main"),
+            ("indirect-batch", "cs_6_0", "main"), ("plane-corners", "vs_6_0", "corner"),
+            ("plane-steps", "ps_6_0", "plane"), ("plane-floats", "ps_6_0", "plane"),
+        ] {
+            let source = format!("src/{name}.hlsl");
+            println!("cargo:rerun-if-changed={source}");
+            compile(Path::new(&source), name, profile, entry);
+            if matches!(name, "indirect-clamp" | "indirect-batch") {
+                let wide = format!("{name}-wide");
+                let generated = out.join(format!("{wide}.hlsl"));
+                let hlsl = std::fs::read_to_string(source).expect("read indirect shader source");
+                std::fs::write(&generated, format!("#define WIDEST 1048576u\n{hlsl}")).expect("prepare wide indirect shader");
+                compile(&generated, &wide, profile, entry);
+            }
+        }
+        println!("cargo:rerun-if-changed=src/ambient.hlsl");
+        let lighting = std::fs::read_to_string("src/ambient.hlsl").expect("read lighting helpers");
+        for (part, entry) in [("KEEP", "keep"), ("KEEP", "mean"), ("PLACE", "place"), ("GATHER", "gather"), ("RAISE", "raise"), ("AIR", "clear_air")] {
+            let name = format!("ambient-{entry}");
+            let source = out.join(format!("{name}.hlsl"));
+            std::fs::write(&source, format!("#define {part}\n{lighting}")).expect("prepare lighting shader source");
+            compile(&source, &name, "cs_6_0", entry);
+        }
+        println!("cargo:rustc-cfg=victory_dxc_compare");
+    }
     let here = PathBuf::from(std::env::var_os("CARGO_MANIFEST_DIR").unwrap_or_default());
     let crates = here.join("..");
     let root = crates.join("..");
diff --git a/crates/victory-gpu/src/ambient.hlsl b/crates/victory-gpu/src/ambient.hlsl
new file mode 100644
index 0000000000000000000000000000000000000000..0580b7012e0561c909b74f4404ab99906de01d36
--- /dev/null
+++ b/crates/victory-gpu/src/ambient.hlsl
@@ -0,0 +1,201 @@
+#define RS "RootConstants(num32BitConstants=12, b0), DescriptorTable(SRV(t0)), DescriptorTable(UAV(u0)), UAV(u1), UAV(u2)"
+#define CX 64
+#define CY 36
+#define CELLS (CX * CY)
+#define PX 160
+#define PY 90
+cbuffer Set : register(b0) {
+    float level; float constant; float strength; float radius;
+    float near; float tan_y; uint width; uint height;
+    float follow; float most; float air; float unused;
+};
+Texture2D<float> depth : register(t0);
+// Cells: the light they send out (then, at CELLS, the slow mean), from
+// CELLS + 1 on where they are.
+RWStructuredBuffer<float4> cells : register(u1);
+// Three a point: red, green and blue, each a mean and a direction.
+RWStructuredBuffer<float4> points : register(u2);
+static const float3 LUMA = float3(0.2126, 0.7152, 0.0722);
+
+// The point seen at a texel, in metres from the eye (x right, y up, z away).
+float3 seen(int2 p, float2 size) {
+    float d = depth.Load(int3(clamp(p, int2(0, 0), int2(size) - 1), 0));
+    float z = min(near / max(d, 1e-7), 1000.0);
+    float2 ndc = (float2(p) + 0.5) / size * 2.0 - 1.0;
+    return float3(ndc.x * tan_y * size.x / size.y * z, -ndc.y * tan_y * z, z);
+}
+
+#ifdef KEEP
+RWTexture2D<float3> radiance : register(u0);
+[RootSignature(RS)]
+[numthreads(8, 4, 1)]
+void keep(uint3 at : SV_DispatchThreadID) {
+    uint w, h;
+    radiance.GetDimensions(w, h);
+    float3 sum = 0;
+    for (uint y = 0; y < 5; y++) for (uint x = 0; x < 5; x++) {
+        uint2 p = uint2((float2(at.xy) + (float2(x, y) + 0.5) / 5.0) * float2(w, h) / float2(CX, CY));
+        float3 c = max(radiance[p], 0.0);
+        c = any(isnan(c)) || any(isinf(c)) ? 0.0 : c;
+        // Lamps and glints count, but not for everything.
+        sum += c / max(1.0, dot(c, LUMA) / 20.0);
+    }
+    cells[at.y * CX + at.x] = float4(sum / 25.0, 1.0);
+}
+[RootSignature(RS)]
+[numthreads(1, 1, 1)]
+void mean() {
+    float3 sum = 0;
+    for (uint i = 0; i < CELLS; i++) sum += cells[i].rgb;
+    float4 was = cells[CELLS];
+    float3 now = sum / CELLS;
+    cells[CELLS] = float4(was.a > 0.0 ? lerp(was.rgb, now, follow) : now, 1.0);
+}
+#endif
+
+#ifdef PLACE
+[RootSignature(RS)]
+[numthreads(8, 4, 1)]
+void place(uint3 at : SV_DispatchThreadID) {
+    float2 size = float2(width, height);
+    float3 p = seen(int2((float2(at.xy) + 0.5) * size / float2(CX, CY)), size);
+    cells[CELLS + 1 + at.y * CX + at.x] = float4(p, p.z * p.z);
+}
+#endif
+
+#ifdef GATHER
+[RootSignature(RS)]
+[numthreads(8, 2, 1)]
+void gather(uint3 at : SV_DispatchThreadID) {
+    float2 size = float2(width, height);
+    float3 p = seen(int2((float2(at.xy) + 0.5) * size / float2(PX, PY)), size);
+    float r2 = 0.25 + 0.0025 * p.z * p.z;
+    float whole = 0;
+    float3 toward = 0, light = 0, red = 0, green = 0, blue = 0;
+    for (uint i = 0; i < CELLS; i++) {
+        float4 c = cells[CELLS + 1 + i];
+        float3 L = cells[i].rgb;
+        float3 d = c.xyz - p;
+        float dd = dot(d, d);
+        float w = c.w / (dd + r2);
+        float3 dir = d / sqrt(dd + 0.25 * r2);
+        whole += w;
+        toward += w * dir;
+        light += w * L;
+        red += w * L.r * dir;
+        green += w * L.g * dir;
+        blue += w * L.b * dir;
+    }
+    whole = max(whole, 1e-6);
+    light /= whole;
+    toward /= whole;
+    uint at0 = (at.y * PX + at.x) * 3;
+    points[at0] = float4(red / whole - light.r * toward, light.r);
+    points[at0 + 1] = float4(green / whole - light.g * toward, light.g);
+    points[at0 + 2] = float4(blue / whole - light.b * toward, light.b);
+}
+#endif
+
+#ifdef AIR
+RWTexture3D<float3> scattered : register(u0);
+// No more than a multiple of the light around: of the room as the last
+// seconds showed it, and of the surface seen in this direction (towards a
+// window the air outside may be as bright as the sky is).
+[RootSignature(RS)]
+[numthreads(8, 8, 2)]
+void clear_air(uint3 at : SV_DispatchThreadID) {
+    uint w, h, d;
+    scattered.GetDimensions(w, h, d);
+    if (at.x >= w || at.y >= h || at.z >= d) return;
+    uint2 q = min(uint2((float2(at.xy) + 0.5) / float2(w, h) * float2(PX, PY)), uint2(PX - 1, PY - 1));
+    uint at0 = (q.y * PX + q.x) * 3;
+    float3 seen_there = float3(points[at0].w, points[at0 + 1].w, points[at0 + 2].w);
+    float far = float(at.z) / float(d);
+    float cap = air * lerp(dot(cells[CELLS].rgb, LUMA), dot(seen_there, LUMA), far);
+    float3 c = scattered[at];
+    float has = dot(c, LUMA);
+    if (has > cap) scattered[at] = c * (cap / has);
+}
+#endif
+
+#ifdef RAISE
+RWTexture2D<uint> light : register(u0);
+float3 unpack(uint v) {
+    return float3(v & 511, (v >> 9) & 511, (v >> 18) & 511) * exp2(float(v >> 27) - 24.0);
+}
+uint pack(float3 c) {
+    c = clamp(c, 0.0, 65408.0);
+    float top = max(c.r, max(c.g, c.b));
+    int e = clamp(int(floor(log2(max(top, 1e-9)))) + 16, 0, 31);
+    float scale = exp2(float(24 - e));
+    if (top * scale >= 511.5) { e = min(e + 1, 31); scale = exp2(float(24 - e)); }
+    uint3 m = min(uint3(c * scale + 0.5), 511u);
+    return m.r | (m.g << 9) | (m.b << 18) | (uint(e) << 27);
+}
+[RootSignature(RS)]
+[numthreads(8, 8, 1)]
+void raise(uint3 at : SV_DispatchThreadID) {
+    float2 size = float2(width, height);
+    if (at.x >= width || at.y >= height) return;
+    int2 p = int2(at.xy);
+    float3 c = seen(p, size);
+    float3 l = seen(p + int2(-1, 0), size), r = seen(p + int2(1, 0), size);
+    float3 u = seen(p + int2(0, -1), size), d = seen(p + int2(0, 1), size);
+    float3 dx = abs(l.z - c.z) < abs(r.z - c.z) ? c - l : r - c;
+    float3 dy = abs(u.z - c.z) < abs(d.z - c.z) ? c - u : d - c;
+    float3 n = normalize(cross(dy, dx) + float3(0, 0, -1e-9));
+    if (dot(n, c) > 0.0) n = -n;
+    // How open it is (as in beloooo's cd9f78ce).
+    float open = 1.0;
+    float px = min(radius * size.y / (2.0 * tan_y * c.z), 128.0);
+    float noise = frac(52.9829189 * frac(dot(float2(p), float2(0.06711056, 0.00583715))));
+    if (strength > 0.0 && px >= 1.5 && c.z < 400.0) {
+        float sum = 0.0;
+        const int N = 12;
+        for (int i = 0; i < N; i++) {
+            float a = i * 2.399963 + noise * 6.2831853;
+            float2 o = float2(cos(a), sin(a)) * (sqrt((i + 0.5) / N) * px);
+            float3 v = seen(p + int2(round(o)), size) - c;
+            float vv = dot(v, v);
+            float over = dot(v, n) - 0.004 * c.z - 0.005;
+            sum += max(over, 0.0) / sqrt(vv + 1e-6) * saturate(1.0 - vv / (radius * radius));
+        }
+        open = saturate(1.0 - strength * 2.0 * sum / N);
+    }
+    float3 found;
+    if (constant > 0.0) {
+        found = float3(1.0, 0.98, 0.94) * constant * open;
+        light[p] = pack(found);
+        return;
+    }
+    // Between the four points around, those at its own depth first; which
+    // four is dithered a little.
+    float2 g = (float2(p) + 0.5) / size * float2(PX, PY) - 0.5 + (noise - 0.5) * 0.5;
+    int2 g0 = int2(floor(g));
+    float2 f = g - float2(g0);
+    float4 sr = 0, sg = 0, sb = 0;
+    float sum = 0;
+    for (int k = 0; k < 4; k++) {
+        int2 q = clamp(g0 + int2(k & 1, k >> 1), int2(0, 0), int2(PX, PY) - 1);
+        float z = seen(int2((float2(q) + 0.5) * size / float2(PX, PY)), size).z;
+        float2 b = float2(k & 1 ? f.x : 1 - f.x, k >> 1 ? f.y : 1 - f.y);
+        float w = (b.x * b.y + 1e-3) / (0.02 + abs(z - c.z) / c.z);
+        uint at0 = (q.y * PX + q.x) * 3;
+        sr += w * points[at0];
+        sg += w * points[at0 + 1];
+        sb += w * points[at0 + 2];
+        sum += w;
+    }
+    float3 all = float3(sr.w, sg.w, sb.w) / sum;
+    found = all + 1.2 * float3(dot(sr.xyz, n), dot(sg.xyz, n), dot(sb.xyz, n)) / sum;
+    found = clamp(found, 0.2 * all, 2.5 * all);
+    found = lerp(found, cells[CELLS].rgb, 0.2) * level * open;
+    float3 was = unpack(light[p]);
+    // What the program left counts as far as it can be true: the sky's light
+    // outdoors, not the blocks of other memory.
+    float top = max(dot(found, LUMA) * most, 1e-6);
+    float has = dot(was, LUMA);
+    was *= min(1.0, top / max(has, 1e-6));
+    light[p] = pack(max(was, found));
+}
+#endif
