+/// Explicit mip zero for every shader or selected container hashes.
+fn uav_size_level0(container: &[u8]) -> bool {
+    static RULE: OnceLock<(bool, Vec<String>)> = OnceLock::new();
+    let (all, hashes) = RULE.get_or_init(|| {
+        let value = std::env::var("VICTORY_UAV_SIZE_LEVEL0").unwrap_or_default();
+        let value = value.trim();
+        if value == "1" {
+            tracing::info!("writable image size queries use level zero");
+            return (true, Vec::new());
+        }
+        let hashes: Vec<_> = value.split(',').map(|entry| entry.trim().to_ascii_lowercase()).collect();
+        if hashes.iter().all(|hash| hash.len() == 16 && hash.bytes().all(|b| b.is_ascii_hexdigit())) {
+            tracing::info!(programs = ?hashes, "selected writable image size queries use level zero");
+            (false, hashes)
+        } else {
+            (false, Vec::new())
+        }
+    });
+    *all || (!hashes.is_empty() && {
+        let hash = blake3::hash(container).to_hex();
+        hashes.iter().any(|candidate| candidate == &hash[..16])
+    })
+}
